{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mini-svs-frontend",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "mini-svs.com",
      "custom_domain": true
    }
  ]
}
